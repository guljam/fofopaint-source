{
	"config": "air",
	"compilerOptions": {
		//external-library-path는 디버깅때 파일을 포함하지만 최종 swf구현에 넣지 않음
		//library-path"는 최종 swf에 포함 시킴
		// "external-library-path": [
		// 	"extension"
		// ],
		"library-path": [
			"extension/libwebp.swc"
		],
		"source-path": [
			"src"
		],
		"output": "fofoPaint.swf",
		"target-player": "51.1",
		"swf-version": 51,
		"debug": true,
		"strict": true,
		"warnings": true,
		"verbose-stacktraces": true
	},
	"application": "fofoPaint-app.xml",
	"mainClass": "Main",
	"type": "app"
}
