{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Worker SWF",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build-worker.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build nativecore ANE",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/anesrc/fofonative/build-ane.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "Compile Main SWF",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build-main.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "FOFO PAINT swf build and debug",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build-all-for-debug.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "Make AIR Package (legacy)",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/make-air-legacy.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Make AIR Bundle (x86 + x64, SDK 51.4.1 runtime)",
            "type": "shell",
            "dependsOn": [
                "Build nativecore ANE"
            ],
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/make-air-bundle.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Publish AIR and Bundle",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/publish-air-and-bundle.ps1"
            ],
            "options": {
                "env": {
                    "FOFO_STOREPASS": "${input:p12StorePassword}"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "p12StorePassword",
            "type": "promptString",
            "description": "p12 인증서 비밀번호 (storepass)",
            "password": true
        }
    ]
}
