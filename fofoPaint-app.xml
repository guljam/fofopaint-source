<application xmlns="http://ns.adobe.com/air/application/32.0">
  <id>fofoPaint</id>
  <versionNumber>13.44</versionNumber>
  <filename>fofoPaint</filename>
  <description/>
  <name>fofoPaint</name>
  <copyright>c301</copyright>
  <initialWindow>
    <content>fofoPaint.swf</content>
    <systemChrome>standard</systemChrome>
    <transparent>false</transparent>
    <visible>true</visible>
    <fullScreen>false</fullScreen>
    <aspectRatio>portrait</aspectRatio>
    <renderMode>auto</renderMode>
    <width>1024</width>
    <height>768</height>
    <minSize>600 400</minSize>
    <maximizable>true</maximizable>
    <minimizable>true</minimizable>
    <resizable>true</resizable>
    </initialWindow>
  <icon>
    <image16x16>resource/icon/icon16.png</image16x16>
    <image32x32>resource/icon/icon32.png</image32x32>
    <image48x48>resource/icon/icon48.png</image48x48>
    <image128x128>resource/icon/icon128.png</image128x128>
  </icon>
  <customUpdateUI>false</customUpdateUI>
  <allowBrowserInvocation>false</allowBrowserInvocation>
  <supportedProfiles>desktop extendedDesktop </supportedProfiles>
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
