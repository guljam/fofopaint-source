<extension xmlns="http://ns.adobe.com/air/extension/33.1">
  <id>com.fofo.pixeldump</id>
  <versionNumber>1.0.0</versionNumber>
  <platforms>
    <platform name="Windows-x86">
      <applicationDeployment>
        <nativeLibrary>pixeldump.dll</nativeLibrary>
        <initializer>PixelDumpExtInit</initializer>
        <finalizer>PixelDumpExtFin</finalizer>
      </applicationDeployment>
    </platform>
    <platform name="Windows-x86-64">
      <applicationDeployment>
        <nativeLibrary>pixeldump.dll</nativeLibrary>
        <initializer>PixelDumpExtInit</initializer>
        <finalizer>PixelDumpExtFin</finalizer>
      </applicationDeployment>
    </platform>
    <!-- 네이티브 빌드가 없는 운영체제(macOS, Linux 등)는 여기로 들어가고, 앱은 AS3 PixelRestore로 동작함 -->
    <platform name="default">
      <applicationDeployment/>
    </platform>
  </platforms>
</extension>
